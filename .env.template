# ---------------------------------------------------------------------------
# Model access (required) — one vision-language model backs the whole agent.
# ---------------------------------------------------------------------------

# Direct Gemini API key. Get one from Google AI Studio and paste it here.
GEMINI_API_KEY=your-api-key-here

# Model id to drive. Set this to a model your key or project can actually access.
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Vertex AI (optional) — use this instead of a direct key to run through GCP.
# Leave GEMINI_API_KEY unset when you go this route.
# ---------------------------------------------------------------------------

# VERTEX_LOCATION=us-central1
# VERTEX_PROJECT_ID=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ---------------------------------------------------------------------------
# Perception subsystems (optional) — each is on by default; set to false to skip
# the corresponding pass and trade a little accuracy for speed.
# ---------------------------------------------------------------------------

# FATHOM_OBSERVATION_CV=false
# FATHOM_OBSERVATION_OCR=false
# FATHOM_OBSERVATION_ICON=false
# FATHOM_OBSERVATION_OVERLAY=false
# FATHOM_OBSERVATION_KEYBOARD=false

# ---------------------------------------------------------------------------
# Ensemble localization (optional) — turn on multi-member voting for grounding
# and list the members that should participate in the vote.
# ---------------------------------------------------------------------------

# FATHOM_ENSEMBLE_LOCALIZER=false
# FATHOM_ENSEMBLE_LOCALIZER_MEMBERS=gemini,ocr,icon

# ---------------------------------------------------------------------------
# Priority / adaptive inference (optional) — let the model adapter shed load and
# recover automatically when the provider gets slow or starts rejecting calls.
# ---------------------------------------------------------------------------

# FATHOM_LLM_PRIORITY_ENABLED=false
# FATHOM_LLM_PRIORITY_MODE=adaptive

# ---------------------------------------------------------------------------
# Conversation / observability store (optional) — the interaction layer records
# threads, messages, tasks, and scripts. It defaults to an in-memory noop store;
# point it at Postgres to keep durable history. Setting a DSN selects Postgres.
# ---------------------------------------------------------------------------

# FATHOM_INTERACTION_BACKEND=postgres
# FATHOM_INTERACTION_POSTGRES_DSN=postgresql://user:password@localhost:5432/fathom

# ---------------------------------------------------------------------------
# Paths (optional) — override where run logs and bundled assets are read/written.
# ---------------------------------------------------------------------------

# FATHOM_RUN_LOGS_PATH=./run-logs
# FATHOM_ASSETS_PATH=./assets

# ---------------------------------------------------------------------------
# Tests (optional) — live tests call a real model and are skipped unless opted in.
# ---------------------------------------------------------------------------

# FATHOM_RUN_LIVE_TESTS=1
